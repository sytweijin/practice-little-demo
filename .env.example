# 通义千问 DashScope API Key
# 申请地址：https://dashscope.console.aliyun.com/
# 留空则使用预生成模式（Demo仍可完整演示，但不调用真实AI）
DASHSCOPE_API_KEY=

# 可选：OpenAI兼容接口（GPT-4V等）
# 同一个 key 也用于语音转写（Whisper）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional DashScope model overrides. Keep commented out to use defaults.
# DASHSCOPE_VISION_MODEL=qwen3.7-plus
# DASHSCOPE_TEXT_MODEL=qwen-plus
# DASHSCOPE_ASR_MODEL=paraformer-v2
